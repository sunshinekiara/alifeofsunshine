---
// Base layout — DESIGN-SYSTEM.md §7.8 (nav), §7.9 (footer).
// Fonts are self-hosted from public/fonts; nothing is fetched from Google at runtime.
// The @fontsource-variable packages stay installed as the source of those woff2 files
// (`npm run fonts:sync`) but their CSS is deliberately NOT imported — it names the
// families "... Variable", which never matched the token stacks. See fonts.css.
import { getEntry } from 'astro:content';
import Seal from '../components/Seal.astro';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  /** Absolute or site-relative URL of the social image for this page (§9.5). */
  ogImage?: string;
  ogType?: 'website' | 'article';
}
const {
  title,
  description = 'Bold, colourful originals, prints and commissions by Sunshine Kiara Bhandary. Bangalore.',
  ogImage,
  ogType = 'website',
} = Astro.props;

// Absolute URLs for canonical and Open Graph. `site` is set in astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const socialImage = ogImage ? new URL(ogImage, Astro.site).href : undefined;

const settings = await getEntry('siteConfig', 'site');
// §7.8 — the announcement bar renders only when she switches it on and has written something.
const announcement = settings?.data.announcement;
const showAnnouncement = Boolean(announcement?.active && announcement.text);
const instagram = settings?.data.instagram ?? 'a_life_of_sunshine';
const shippingRegions = settings?.data.shippingRegions;

// §7.8 — the left link row, and the current-section underline. `/contact` joins at step 7.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const navLinks = [
  { href: '/work', label: 'Work' },
  { href: '/prints', label: 'Prints' },
  { href: '/originals', label: 'Originals' },
  { href: '/commissions', label: 'Commissions' },
  { href: '/events', label: 'Events' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <!-- Work in progress: keep the half-built site out of search results.
         Remove this before launch (DESIGN-SYSTEM.md polish step). -->
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    {/* Icons are derived from her seal (scripts/build-brand-assets.mjs). §9.6 wants the
        simplified mark at 32px once it is traced and approved; until then this is her real
        seal, which at 16-32px is muddy but is hers rather than Astro's default logo. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* Open Graph / Twitter. §9.5 governs the image itself. */}
    <meta property="og:site_name" content="A Life Of Sunshine" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="en_IN" />
    {socialImage && <meta property="og:image" content={socialImage} />}
    {socialImage && <meta property="og:image:width" content="1200" />}
    {socialImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={socialImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && <meta name="twitter:image" content={socialImage} />}

    {/* §3.1: preload both latin faces. crossorigin is required even same-origin,
        or the browser fetches the file a second time for the CSS. latin-ext is
        deliberately not preloaded — unicode-range fetches it only when needed. */}
    <link
      rel="preload"
      href="/fonts/bodoni-moda-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/fonts/dm-sans-latin.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />

    {/* §6.1 — the artwork detail page preloads its LCP image here with imagesrcset. */}
    <slot name="head" />
  </head>

  <body>
    <a class="skip-link" href="#content">Skip to content</a>

    {/* §7.8 — announcement bar, above the nav. No close button: she controls it from the CMS. */}
    {
      showAnnouncement &&
        (announcement!.link ? (
          <a class="announcement" href={announcement!.link}>
            <span class="announcement__text">{announcement!.text}</span>
          </a>
        ) : (
          <div class="announcement">
            <span class="announcement__text">{announcement!.text}</span>
          </div>
        ))
    }

    <header class="site-header">
      <div class="container">
        <nav class="nav" aria-label="Main">
          <div class="nav__wordmark-cell">
            <a class="wordmark" href="/">A Life Of Sunshine</a>
          </div>

          {/* §7.8 puts about/contact in a right-hand group on desktop. They are in this one
              row instead: the right slot holds the Instagram glyph and the reserved phase-2 bag,
              and splitting six links across two groups at 12px caps would crowd the lockup. */}
          <div class="nav__links">
            {navLinks.map((l) => (
              <a
                href={l.href}
                class:list={{ 'is-current': isCurrent(l.href) }}
                aria-current={isCurrent(l.href) ? 'page' : undefined}
              >
                {l.label}
              </a>
            ))}
          </div>

          <div class="nav__utility">
            <a
              class="nav__ig"
              href="https://www.instagram.com/a_life_of_sunshine/"
              rel="noopener"
              aria-label="instagram"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75"
                   stroke-linecap="round" aria-hidden="true" focusable="false">
                <rect x="3" y="3" width="18" height="18" rx="5" />
                <circle cx="12" cy="12" r="4" />
                <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor" stroke="none" />
              </svg>
            </a>
            {/* Reserved for the phase-2 bag icon. Empty on purpose — see §7.8. */}
            <div class="nav__bag-slot" aria-hidden="true"></div>
          </div>
        </nav>
      </div>
    </header>

    <main id="content">
      <slot />
    </main>

    <footer class="footer">
      <div class="container">
        {/* §7.9 — the seal, then SUNSHINE . KIARA . BHANDARY beneath it. */}
        <div class="footer__seal">
          <Seal width={160} />
          <p class="wordmark__sub">Sunshine · Kiara · Bhandary</p>
        </div>
        <p class="body-sm">
          Canvas &amp; digital artist · Bangalore{shippingRegions ? ` · ships ${shippingRegions}` : ''}
        </p>
        <p class="body-sm">
          <a href={`https://www.instagram.com/${instagram}/`} rel="noopener">@{instagram}</a>
        </p>
      </div>
    </footer>
  </body>
</html>

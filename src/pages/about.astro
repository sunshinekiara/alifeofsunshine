---
/**
 * /about — DESIGN-SYSTEM.md §13.
 *
 * The body text is her artist statement, verbatim from page 2 of her art book ("A Little About
 * Me"). Nothing here is written for her. It lives in src/content/pages/about.md so she can edit
 * it through /admin.
 *
 * The seal is her actual artwork with its sage field keyed out, not a trace (see
 * scripts/build-brand-assets.mjs). §9.6's traced SVG replaces it when she approves one.
 */
import { Image } from 'astro:assets';
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Seal from '../components/Seal.astro';

const about = await getEntry('page', 'about');
if (!about) throw new Error('src/content/pages/about.md is missing');
const { Content } = await render(about);
const press = about.data.press ?? [];
---

<Base
  title="About — A Life Of Sunshine"
  description="Sunshine Kiara Bhandary is a self-taught canvas and digital artist in Bangalore."
>
  <div class="container container--text section">
    <div class="about__intro">
      {
        about.data.portrait && (
          <div class="about__portrait">
            <Image
              src={about.data.portrait}
              alt={about.data.portraitAlt ?? 'Sunshine Kiara Bhandary'}
              widths={[280, 560]}
              sizes="280px"
              formats={['avif', 'webp']}
              quality={78}
              layout="none"
              loading="eager"
              decoding="sync"
            />
          </div>
        )
      }

      <div>
        <h1 class="display-2">About</h1>
        <div class="prose body-lg measure" style="margin-top: var(--space-5);">
          <Content />
        </div>
      </div>
    </div>

    {/* §13 — the seal at 200px, centred, with wordmark-sub beneath. aria-hidden because her
        name is already in the text above (§10.3). */}
    <div class="about__lockup">
      <Seal width={200} decorative={true} />
      <span class="wordmark__sub">Sunshine · Kiara · Bhandary</span>
    </div>

    {/* §13 — omitted entirely if empty. */}
    {
      press.length > 0 && (
        <section style="margin-top: var(--section-gap);">
          <h2 class="heading">Press &amp; mentions</h2>
          <ul class="stack" style="margin-top: var(--space-5);">
            {press.map((item) => (
              <li class="body-sm">
                {item.link ? <a href={item.link} rel="noopener">{item.text}</a> : item.text}
              </li>
            ))}
          </ul>
        </section>
      )
    }
  </div>
</Base>

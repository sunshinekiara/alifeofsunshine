---
/**
 * Buy / enquire block — DESIGN-SYSTEM.md §7.2.
 *
 * One <form> so the size a visitor picks with zero JavaScript is posted with the enquiry. The
 * Instagram action is a plain <a>. §7.2's phase-2 contract: the primary slot stays exactly one
 * interactive element at 48px and full slot width — only its label changes when the cart lands.
 *
 * The secondary slot is the enquiry disclosure's own <summary> (§7.3), which sits inside this
 * form so the selected print size posts with the enquiry. Closed it reads as the second button;
 * open it takes the full row and the fields appear beneath.
 */
import PrintSizeGuide from './PrintSizeGuide.astro';
import Badge from './Badge.astro';
import EnquiryForm from './EnquiryForm.astro';
import { PRINT_DIMENSIONS, formatPrice, hasPrints, orderedSizes } from '../lib/artwork';
import type { Artwork } from '../lib/artwork';

interface Props {
  artwork: Artwork;
  instagram: string;
  shippingRegions?: string;
  printPaper?: string;
  processingTime?: string;
  /** brief.md §8 — the phase-2 switch. False for the whole of phase 1: the primary slot is a
   *  DM link, never "Add to bag". Wired here so flipping the flag is the only change needed. */
  commerceEnabled?: boolean;
}
const {
  artwork,
  instagram,
  shippingRegions,
  printPaper,
  processingTime,
  commerceEnabled = false,
} = Astro.props;

const original = artwork.data.original;
const showOriginal = Boolean(original?.forSale || original?.status);
const sizes = orderedSizes(artwork);
const showPrints = hasPrints(artwork);
const gone = original?.status === 'sold' || original?.status === 'reserved';

// §7.2 — the primary label changes with state, the geometry never does.
const primaryLabel = !showOriginal && !showPrints
  ? 'Ask about this piece'
  : gone
    ? 'Ask about similar work'
    : 'DM to order';

const dmHref = `https://ig.me/m/${instagram}`;

// §7.2 trust line, built from siteConfig. One line, wraps to two on mobile.
const trustParts = [
  'prepaid only',
  shippingRegions ? `ships ${shippingRegions}` : null,
  showOriginal ? 'no returns on originals' : null,
].filter(Boolean);
const showTrust = (showOriginal || showPrints) && trustParts.length > 0;

const printCaption = [printPaper, processingTime ? `ships in ${processingTime}` : null]
  .filter(Boolean)
  .join(' · ');
---

<form
  class="buy"
  name="artwork-enquiry"
  method="POST"
  action="/thanks"
  data-netlify="true"
  data-netlify-honeypot="bot-field"
>
  {/* Netlify Forms plumbing. `context` is the artwork so she knows what the enquiry is about
      without asking (§7.3), truncated to 120 characters per §7.3's overflow rule. */}
  <input type="hidden" name="form-name" value="artwork-enquiry" />
  <input type="hidden" name="context" value={artwork.data.title.slice(0, 120)} />
  <input type="hidden" name="context-slug" value={artwork.id} />
  <p class="enquiry__honeypot"><label>don’t fill this in <input name="bot-field" /></label></p>

  {
    showOriginal && (
      <div class:list={['buy__row', { 'is-gone': gone }]}>
        <p class="eyebrow">The original</p>
        <p class="buy__original">
          {original?.price !== undefined ? (
            <span class="price-lg">{formatPrice(original.price)}</span>
          ) : original?.forSale ? (
            <span class="body-sm buy__on-request">price on request</span>
          ) : null}
          {original?.status && <Badge kind={original.status} />}
        </p>
      </div>
    )
  }

  {
    showPrints && (
      <div class="buy__row">
        <p class="eyebrow">Prints</p>
        <ul class="prints">
          {sizes.map((s, i) => (
            <li class="prints__row">
              <label class="prints__label">
                {/* Native radio, restyled. Smallest size checked by default (§7.2). */}
                <input type="radio" name="size" value={s.size} checked={i === 0} />
                <span class="prints__size">{s.size}</span>
                <span class="prints__dims body-sm">{PRINT_DIMENSIONS[s.size].cm} cm</span>
                <span class="prints__price price">
                  {s.price !== undefined ? formatPrice(s.price) : '—'}
                </span>
              </label>
            </li>
          ))}
        </ul>
        {printCaption && <p class="caption prints__note">{printCaption}</p>}
        {/* §6.3 — omitted below two sizes. */}
        {sizes.length >= 2 && <PrintSizeGuide offered={sizes.map((s) => s.size)} />}
      </div>
    )
  }

  <div class="buy__actions">
    {
      commerceEnabled ? (
        /* Phase 2 — the identical slot, a submit button instead of a link (§7.2). Never
           reached while commerceEnabled is false, which is all of phase 1. */
        <button class="btn btn--primary" type="submit">Add to bag</button>
      ) : (
        <a class="btn btn--primary" href={dmHref} rel="noopener">{primaryLabel}</a>
      )
    }

    {/* §7.2 secondary slot — the disclosure's own summary, so it reads as the second button
        when closed and expands to the full row when open. */}
    <EnquiryForm
      name="artwork-enquiry"
      mode="fields"
      instagram={instagram}
      summaryLabel="Enquire instead"
    />
  </div>

  {showTrust && (
    <p class="caption buy__trust">
      {trustParts.join(' · ')} · <a href="/policies">policies</a>
    </p>
  )}
</form>
